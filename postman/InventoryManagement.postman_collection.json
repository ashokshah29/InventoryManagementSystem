{
  "info": {
    "name": "Inventory Management System (Backend)",
    "_postman_id": "0d1ca906-50f0-4c15-9717-88fb30a06670",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run request 01 to save the productId, then run the other requests."
  },
  "item": [
    {
      "name": "01 - Create Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sku\": \"PEN-001\",\n  \"name\": \"Blue Ball Pen\",\n  \"category\": \"Stationery\",\n  \"description\": \"Blue ink ballpoint pen\",\n  \"quantity\": 30,\n  \"unitPrice\": 15.50,\n  \"lowStockThreshold\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set(\"productId\", pm.response.json().id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "02 - Get All Products",
